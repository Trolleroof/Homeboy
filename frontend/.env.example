# Project-owned robot recorder (optional override)
# HOMEBOY_PYTHON=/path/to/python-with-lerobot
# Native EmbeddingGemma 2 service (default auto-starts locally)
# HOMEBOY_VIDEO_EMBED_URL=http://127.0.0.1:8622
# Demo heuristics, not calibrated confidence
# HOMEBOY_VIDEO_MATCH_THRESHOLD=0.65
# HOMEBOY_VIDEO_MATCH_MARGIN=0.03
# Optional local robot vision and task harness
# OLLAMA_URL=http://127.0.0.1:11434
# Keewano: read from ../bridge/.env.local when unset here (SDK-type project key)
# KEEWANO_API_KEY=
