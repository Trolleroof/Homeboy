# Dial CLI signup uses --coupon DIAL_FOR_SPEEDHACKS. After signup the adapter
# reads ~/.local/share/dial/auth.v1.json (or legacy auth.json);
# set DIAL_API_KEY only to override it.
# DIAL_API_KEY=
# Optional when the account has exactly one ready SMS number.
DIAL_NUMBER_ID=
# Or use the E.164 DIAL_NUMBER from the sponsor's quickstart.
DIAL_NUMBER=
# Required: authorized sender numbers, comma-separated, in E.164 format.
# Hackathon SMS supports Dial-to-Dial; regular-phone replies need 10DLC.
HOMEBOY_SMS_ALLOWED_SENDERS=
# Keep these services on loopback. Never expose the robot bridge publicly.
HOMEBOY_BRIDGE_URL=http://127.0.0.1:8621
# Optional: a verified HTTPS read-only result page accessible from the phone.
# Without one, SMS returns the run ID and asks the operator to inspect Homeboy.
HOMEBOY_SMS_RESULT_URL=

# Keewano run history. KEEWANO_API_KEY must be an SDK-type project key
# (Settings -> API Keys); it is only used to write events and agent traces.
# Reads use the kwpat- token over SQL (host pgsql.keewano.com:27543,
# database = project UUID). Unset = tracing off and default speed.
KEEWANO_API_KEY=
KEEWANO_PROJECT_ID=
KEEWANO_EMAIL=
KEEWANO_PAT=
# Optional: names the arm in Keewano (default so101-arm-1) and flags QA traffic.
# KEEWANO_ARM_ID=so101-arm-1
# KEEWANO_TEST_USER=

# Only this caller can query Homeboy through Dial voice MCP.
DIAL_VOICE_ALLOWED_CALLERS=
DIAL_MCP_SECRET=
DIAL_MCP_URL=
